# Managed by chezmoi (source: ~/Workspace/dotfiles/dot_zshrc).
# Edit the source and run `chezmoi apply`, or use `chezmoi edit ~/.zshrc`.
# Machine-specific or work-only settings go in ~/.zshrc.local (not managed).

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Nothing below this block may print to the terminal, or p10k shows a warning
# on every new shell.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

plugins=(
  # Git
  git
  gitfast
  gh

  # Tooling (the asdf plugin puts ~/.asdf/shims on PATH)
  asdf

  # Languages
  python
  pip
  mix
  ruby

  # Productivity
  fzf
  z
  copypath
  copyfile
  extract
  web-search

  # macOS
  macos
  brew
  vscode

  # Custom plugins, installed by run_once_04_setup_ohmyzsh.sh
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Java from asdf, also needed to build Erlang
[[ -f ~/.asdf/plugins/java/set-java-home.zsh ]] && source ~/.asdf/plugins/java/set-java-home.zsh
export KERL_CONFIGURE_OPTIONS="--with-wx --with-odbc"

# colorls
if command -v colorls &> /dev/null; then
  COLORLS_TAB_COMPLETE="$(dirname $(gem which colorls 2>/dev/null))/tab_complete.sh"
  [[ -f "$COLORLS_TAB_COMPLETE" ]] && source "$COLORLS_TAB_COMPLETE"

  alias ls='colorls --dark'                    # Colorful directory listing
  alias lc='colorls --dark -lA --sd'           # Long format with directories first
  alias la='colorls --dark -la'                # Show all files including hidden ones
  alias ll='colorls --dark -l'                 # Detailed long listing
  alias tree='colorls --dark --tree'           # Tree view of directory structure
fi

# uv / ~/.local/bin
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Machine-specific and work-only settings (not in this public repo)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
